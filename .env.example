# Components managed by this deployment. Supported values:
# turboflare, beeline, beget, reality
DEPLOY_COMPONENTS=turboflare,reality

# Public IPv4 of the origin. 203.0.113.0/24 is reserved for documentation.
ORIGIN_IP=203.0.113.10

# Map fragments included from the existing Nginx stream map.
STREAM_MAP_DIR=/etc/nginx/stream-map.d

# Neutral label used in generated Remnawave checklists.
CONFIG_PROFILE_NAME=LAB_PROFILE

# -----------------------------------------------------------------------------
# TurboFlare CDN
# -----------------------------------------------------------------------------

# Dedicated domain delegated to TurboFlare.
DOMAIN=cdn.example.com
ORIGIN_PORT=443

# Local Nginx TLS vhost behind the stream/SNI router.
NGINX_INTERNAL_PORT=8443

# Local Xray XHTTP inbound managed by Remnawave Node.
XRAY_LISTEN_IP=127.0.0.1
XRAY_XHTTP_PORT=40112
XRAY_INBOUND_TAG=xHTTP-TurboFlare
XHTTP_PATH=/static/getFile/video/segment.ts

# Self-signed certificate used only between TurboFlare and origin.
ORIGIN_CERT_DAYS=3650

# Neutral static cover page.
COVER_ROOT=/var/www/turboflare-cover
COVER_TITLE="Service is online"

TURBOFLARE_STREAM_MAP_FILE=turboflare.map
SQUAD_NAME=TurboFlare-Lab

# -----------------------------------------------------------------------------
# Beeline CDN
# -----------------------------------------------------------------------------

# Direct origin name. It must have an A record pointing to ORIGIN_IP.
BEELINE_ORIGIN_DOMAIN=origin-node.example.net

# Technical domain assigned by Beeline and optional custom CNAME.
BEELINE_CDN_SYSTEM_DOMAIN=abc123xyz.a.trbcdn.net
BEELINE_CDN_CUSTOM_DOMAIN=
BEELINE_ORIGIN_PORT=443

# Beeline gets a separate HTTPS vhost and Xray inbound because it uses GET.
BEELINE_NGINX_INTERNAL_PORT=8444
BEELINE_XRAY_LISTEN_IP=127.0.0.1
BEELINE_XRAY_XHTTP_PORT=4443
BEELINE_XRAY_INBOUND_TAG=xHTTP-Beeline
BEELINE_XHTTP_PATH=/api/uploadFile/

# Certificate mode:
# - selfsigned: generated locally; origin verification in Beeline must be off;
# - letsencrypt: Certbot issues and renews a trusted certificate automatically;
# - existing: use certificate and key paths supplied below.
BEELINE_ORIGIN_CERT_MODE=selfsigned
BEELINE_ORIGIN_CERT=
BEELINE_ORIGIN_KEY=
BEELINE_ORIGIN_CERT_DAYS=3650

BEELINE_COVER_ROOT=/var/www/beeline-cover
BEELINE_COVER_TITLE="Service is online"
BEELINE_ACME_ROOT=/var/www/beeline-acme
# Required only for letsencrypt. Set AGREE_TOS=true only after accepting the
# Let's Encrypt subscriber agreement.
BEELINE_ACME_EMAIL=
BEELINE_ACME_AGREE_TOS=false
BEELINE_STREAM_MAP_FILE=beeline.map
BEELINE_SQUAD_NAME=Beeline-CDN

# -----------------------------------------------------------------------------
# Beget CDN
# -----------------------------------------------------------------------------

# Direct origin name. It must have an A record pointing to ORIGIN_IP and must
# not point to *.begetcdn.cloud.
BEGET_ORIGIN_DOMAIN=node-beget.example.net

# Technical domain assigned by Beget and an optional custom CDN alias.
BEGET_CDN_SYSTEM_DOMAIN=abc123.begetcdn.cloud
BEGET_CDN_CUSTOM_DOMAIN=
BEGET_ORIGIN_PORT=443

# Beget uses a dedicated HTTPS vhost and Xray inbound for packet-up + GET.
BEGET_NGINX_INTERNAL_PORT=8445
BEGET_XRAY_LISTEN_IP=127.0.0.1
BEGET_XRAY_XHTTP_PORT=10085
BEGET_XRAY_INBOUND_TAG=xHTTP-Beget
BEGET_XHTTP_PATH=/

# Let's Encrypt is the recommended mode from the Beget guide:
# - letsencrypt: Certbot issues and renews a trusted certificate automatically;
# - existing: use certificate and key paths supplied below;
# - selfsigned: only if Beget origin certificate verification is disabled.
BEGET_ORIGIN_CERT_MODE=letsencrypt
BEGET_ORIGIN_CERT=
BEGET_ORIGIN_KEY=
BEGET_ORIGIN_CERT_DAYS=3650

BEGET_ACME_ROOT=/var/www/beget-acme
# Required only for letsencrypt. Set AGREE_TOS=true only after accepting the
# Let's Encrypt subscriber agreement.
BEGET_ACME_EMAIL=
BEGET_ACME_AGREE_TOS=false
BEGET_STREAM_MAP_FILE=beget.map
BEGET_SQUAD_NAME=Beget-CDN

# -----------------------------------------------------------------------------
# Direct VLESS Reality
# -----------------------------------------------------------------------------

# Nginx exposes Reality on the same public port 443 by routing these SNI values
# to the local listener.
REALITY_LISTEN_IP=127.0.0.1
REALITY_PORT=2443
REALITY_INBOUND_TAG=xHTTP-Yandexcloud
REALITY_XHTTP_PATH=/replace-with-a-random-path
REALITY_TARGET=functions.yandexcloud.net:443
REALITY_SERVER_NAMES=functions.yandexcloud.net,api-maps.yandex.ru,mediafeeds.yandex.ru

# install.sh replaces these placeholders when Reality is enabled and keeps the
# generated values on subsequent runs.
REALITY_PRIVATE_KEY=REPLACE_WITH_X25519_PRIVATE_KEY
REALITY_PASSWORD=REPLACE_WITH_X25519_PASSWORD
REALITY_SHORT_IDS=REPLACE_WITH_HEX_SHORT_ID

# Used only when xray is not installed on the host.
XRAY_KEYGEN_CONTAINER=remnanode
REALITY_STREAM_MAP_FILE=reality.map
