server {
    listen 80;
    server_name ${BEGET_ORIGIN_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root ${BEGET_ACME_ROOT};
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 127.0.0.1:${BEGET_NGINX_INTERNAL_PORT} ssl proxy_protocol;
    http2 on;

    server_name ${BEGET_ORIGIN_DOMAIN};

    ssl_certificate     ${BEGET_TLS_CERT_PATH};
    ssl_certificate_key ${BEGET_TLS_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:BEGET_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header proxy_protocol;
    real_ip_recursive on;

    access_log /var/log/nginx/${BEGET_ORIGIN_DOMAIN}.access.log;
    error_log  /var/log/nginx/${BEGET_ORIGIN_DOMAIN}.error.log warn;

    # packet-up + GET can place sizeable payloads in the URI and headers.
    large_client_header_buffers 8 128k;
    client_header_buffer_size 64k;
    client_body_buffer_size 64k;
    client_max_body_size 0;
    gzip off;

    location = /healthz {
        access_log off;
        add_header Cache-Control "no-store" always;
        return 204;
    }

    # The reference Beget setup proxies the complete HTTPS origin to Xray.
    # Xray itself validates BEGET_XHTTP_PATH.
    location / {
        proxy_pass http://${BEGET_XRAY_NGINX_BACKEND}:${BEGET_XRAY_XHTTP_PORT};
        proxy_http_version 1.1;

        proxy_set_header Host ${BEGET_ORIGIN_DOMAIN};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_set_header Expect "";

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_cache_bypass 1;
        proxy_no_cache 1;

        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        send_timeout 3600s;

        add_header Cache-Control "private, no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }
}
