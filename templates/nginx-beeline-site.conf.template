server {
    listen 80;
    server_name ${BEELINE_ORIGIN_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root ${BEELINE_ACME_ROOT};
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 127.0.0.1:${BEELINE_NGINX_INTERNAL_PORT} ssl proxy_protocol;
    http2 on;

    server_name ${BEELINE_ORIGIN_DOMAIN};

    ssl_certificate     ${BEELINE_TLS_CERT_PATH};
    ssl_certificate_key ${BEELINE_TLS_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:BEELINE_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header proxy_protocol;
    real_ip_recursive on;

    access_log /var/log/nginx/${BEELINE_ORIGIN_DOMAIN}.access.log;
    error_log  /var/log/nginx/${BEELINE_ORIGIN_DOMAIN}.error.log warn;

    location ^~ ${BEELINE_XHTTP_PATH} {
        client_max_body_size 4m;

        proxy_pass http://${BEELINE_XRAY_NGINX_BACKEND}:${BEELINE_XRAY_XHTTP_PORT};
        proxy_http_version 1.1;

        proxy_set_header Host ${BEELINE_ORIGIN_DOMAIN};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_set_header Expect "";

        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_cache_bypass 1;
        proxy_no_cache 1;

        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        send_timeout 3600s;

        add_header Cache-Control "private, no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location = /healthz {
        access_log off;
        add_header Cache-Control "no-store" always;
        return 204;
    }

    root ${BEELINE_COVER_ROOT};
    index index.html;

    location / {
        try_files $uri $uri/ /index.html =404;
    }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
